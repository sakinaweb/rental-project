# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Name shown in emails, SMS and the admin panel.
APP_NAME="Rental Platform"
# local | staging | production. Use production on live servers.
APP_ENV=local
# Encryption key. Generate with: php artisan key:generate. Never share or change it after going live.
APP_KEY=
# Show detailed error pages. Must be false in production.
APP_DEBUG=true
# Public base URL of this backend, no trailing slash.
APP_URL=http://localhost:8000

# Default locale when the user or request doesn't choose one. Supported: en, ar, hi, es, de.
APP_LOCALE=en
# Locale used when a string is missing in the current locale.
APP_FALLBACK_LOCALE=en
# Locale for generated fake data (seeders/tests only).
APP_FAKER_LOCALE=en_US

# How maintenance mode is stored: file (single server) or cache (multiple servers).
APP_MAINTENANCE_DRIVER=file
# Cache store used when APP_MAINTENANCE_DRIVER=cache.
# APP_MAINTENANCE_STORE=database

# Worker processes for `php artisan serve` (local development only).
# PHP_CLI_SERVER_WORKERS=4

# Password hashing cost. Higher is slower and safer.
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Log channel. stack writes to the channels listed in LOG_STACK.
LOG_CHANNEL=stack
# Channels used by the stack channel (single = storage/logs/laravel.log).
LOG_STACK=single
# Where PHP/library deprecation warnings go. null discards them.
LOG_DEPRECATIONS_CHANNEL=null
# Minimum level to log: debug, info, notice, warning, error, critical, alert, emergency.
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database (MySQL 8)
# ---------------------------------------------------------------------------
# Database driver. The platform targets MySQL 8.
DB_CONNECTION=mysql
# Database host. Use "mysql" with the bundled docker-compose.yml, 127.0.0.1 on shared hosting.
DB_HOST=127.0.0.1
# Database port. docker-compose.yml also exposes MySQL on host port 3307.
DB_PORT=3306
# Database name.
DB_DATABASE=rental
# Database user.
DB_USERNAME=rental
# Database password.
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Sessions (admin panel / web; the mobile API uses Sanctum tokens instead)
# ---------------------------------------------------------------------------
# Session storage: database, file, redis, cookie.
SESSION_DRIVER=database
# Minutes of inactivity before a session expires.
SESSION_LIFETIME=120
# Encrypt session data at rest.
SESSION_ENCRYPT=false
# Cookie path for the session cookie.
SESSION_PATH=/
# Cookie domain for the session cookie. null = current host.
SESSION_DOMAIN=null

# ---------------------------------------------------------------------------
# Broadcasting, files, queues, cache
# ---------------------------------------------------------------------------
# Real-time broadcasting driver. log = disabled (writes to log).
BROADCAST_CONNECTION=log
# Default file storage: local (default) or s3 (fill in the AWS_* keys below).
FILESYSTEM_DISK=local
# Staff handover/return and damage photos: public (run `php artisan storage:link` once) or s3.
INSPECTIONS_DISK=public
# Queue driver: redis (preferred) or database (shared-hosting fallback, run `schedule:run` via cron every minute).
QUEUE_CONNECTION=redis

# Cache store: redis (preferred), database or file (shared-hosting fallback).
CACHE_STORE=redis
# Prefix for cache keys, useful when several apps share one Redis.
# CACHE_PREFIX=

# Memcached host (only if CACHE_STORE=memcached).
MEMCACHED_HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Redis (cache, queues, rate limiting)
# ---------------------------------------------------------------------------
# PHP Redis client: phpredis (extension) or predis (pure PHP package).
REDIS_CLIENT=phpredis
# Redis host. Use "redis" with the bundled docker-compose.yml.
REDIS_HOST=127.0.0.1
# Redis password. null = no password.
REDIS_PASSWORD=null
# Redis port.
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# Mail driver: smtp, ses, postmark, resend, log (writes emails to the log).
MAIL_MAILER=log
# SMTP scheme: smtp or smtps. null = auto.
MAIL_SCHEME=null
# SMTP host.
MAIL_HOST=127.0.0.1
# SMTP port.
MAIL_PORT=2525
# SMTP username.
MAIL_USERNAME=null
# SMTP password.
MAIL_PASSWORD=null
# Sender address for outgoing mail.
MAIL_FROM_ADDRESS="hello@example.com"
# Sender name for outgoing mail.
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Payment gateways (a gateway is offered only when all its keys are set)
# Webhook URLs to register in the gateway dashboards:
#   Stripe:   {APP_URL}/api/v1/payments/webhook/stripe   (events: payment_intent.succeeded, payment_intent.payment_failed)
#   Razorpay: {APP_URL}/api/v1/payments/webhook/razorpay (events: payment.captured, order.paid, payment.failed)
# ---------------------------------------------------------------------------
# Stripe publishable key (pk_test_… / pk_live_…), sent to the app to complete payment.
STRIPE_KEY=
# Stripe secret key (sk_test_… / sk_live_…). Server-side only.
STRIPE_SECRET=
# Stripe webhook signing secret (whsec_…) from the webhook endpoint settings.
STRIPE_WEBHOOK_SECRET=
# Razorpay key id (rzp_test_… / rzp_live_…), sent to the app to open checkout.
RAZORPAY_KEY_ID=
# Razorpay key secret. Server-side only.
RAZORPAY_KEY_SECRET=
# Razorpay webhook secret set when creating the webhook.
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Push notifications (customer app)
# ---------------------------------------------------------------------------
# Absolute path to a Firebase service-account JSON (Firebase console → Project settings → Service accounts).
# Empty = pushes are written to the log instead of being sent.
FCM_CREDENTIALS=

# ---------------------------------------------------------------------------
# OTP by SMS: Twilio Verify (console.twilio.com → Verify → Services)
# All three set = Twilio sends and checks the codes; any empty = codes are written to the log.
# A trial account only sends to numbers verified in the Twilio console.
# ---------------------------------------------------------------------------
# Account SID (AC…), from the console dashboard.
TWILIO_ACCOUNT_SID=
# Auth token, from the console dashboard. Server-side only.
TWILIO_AUTH_TOKEN=
# Verify service SID (VA…). Use a 6-digit code length (the apps ask for 6 digits).
TWILIO_VERIFY_SID=

# ---------------------------------------------------------------------------
# S3 object storage (optional; only used when FILESYSTEM_DISK=s3)
# ---------------------------------------------------------------------------
# S3 access key ID.
AWS_ACCESS_KEY_ID=
# S3 secret access key.
AWS_SECRET_ACCESS_KEY=
# S3 region.
AWS_DEFAULT_REGION=us-east-1
# S3 bucket name.
AWS_BUCKET=
# true for S3-compatible services that need path-style URLs (e.g. MinIO).
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Frontend build
# ---------------------------------------------------------------------------
# App name exposed to Vite-built frontend assets.
VITE_APP_NAME="${APP_NAME}"
